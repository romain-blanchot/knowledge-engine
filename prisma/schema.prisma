generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  COMPLETED
}

enum ProjectPhase {
  PREPARATION
  CADRAGE
  PROPOSITION
  MISSION
}

enum DocumentCategory {
  BUSINESS_CONTEXT
  COMPANY_KNOWLEDGE
  CAHIER_DES_CHARGES
  SFD
  TECHNICAL_NOTES
  ARCHITECTURE_DECISIONS
  OPEN_QUESTIONS
  INDUSTRY_ANALYSIS
}

enum DocumentStatus {
  INDEXED
  PENDING
  NEEDS_REVIEW
  DRAFT
}

enum DecisionStatus {
  APPROVED
  PENDING
  REJECTED
  SUPERSEDED
}

enum DecisionInputType {
  TEXT
  AUDIO
  FILE
}

enum QuestionPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum QuestionStatus {
  OPEN
  ACCEPTED
  REJECTED
  IN_PROGRESS
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ExplorationCategory {
  CONTEXTE_ENTREPRISE
  ENJEUX_SECTORIELS
  QUESTIONS_RDV
  HYPOTHESES
  PISTES_CADRAGE
}

enum IntegrationStatus {
  CONNECTED
  PENDING
  AVAILABLE
  DISABLED
}

model Project {
  id              String        @id @default(cuid())
  name            String
  client          String
  description     String
  summary         String?
  status          ProjectStatus @default(ACTIVE)
  phase           ProjectPhase  @default(PREPARATION)
  industry        String
  lastActivity    DateTime      @default(now()) @map("last_activity")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  documents     Document[]
  conversations Conversation[]
  decisions     Decision[]
  explorations  ExplorationPath[]
  activities    Activity[]
  issues        ProjectIssue[]

  @@map("projects")
}

model ProjectIssue {
  id          String   @id @default(cuid())
  title       String
  description String?
  severity    String   @default("medium")
  resolved    Boolean  @default(false)
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_issues")
}

model Document {
  id                 String           @id @default(cuid())
  title              String
  category           DocumentCategory
  status             DocumentStatus   @default(DRAFT)
  summary            String?
  content            String?
  author             String
  tags               String[]
  ragIndexed         Boolean          @default(false) @map("rag_indexed")
  needsClarification Boolean          @default(false) @map("needs_clarification")
  sectionsCount      Int              @default(0) @map("sections_count")
  projectId          String           @map("project_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections DocumentSection[]

  @@map("documents")
}

model DocumentSection {
  id          String  @id @default(cuid())
  title       String
  content     String
  order       Int
  highlighted Boolean @default(false)
  documentId  String  @map("document_id")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_sections")
}

model Conversation {
  id        String   @id @default(cuid())
  title     String
  projectId String   @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id               String      @id @default(cuid())
  role             MessageRole
  content          String
  summary          String?
  operationalImpacts String[]  @map("operational_impacts")
  clientImpacts    String[]    @map("client_impacts")
  documentsUsed    String[]    @map("documents_used")
  processesUsed    String[]    @map("processes_used")
  openQuestions    String[]    @map("open_questions")
  risks            String[]
  suggestedActions String[]    @map("suggested_actions")
  confidenceScore  Int?        @map("confidence_score")
  conversationId   String      @map("conversation_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Decision {
  id            String           @id @default(cuid())
  title         String
  context       String
  justification String
  impact        String
  author        String
  status        DecisionStatus   @default(PENDING)
  inputType     DecisionInputType @default(TEXT) @map("input_type")
  transcript    String?
  synthesis     String?
  relatedDocs   String[]         @map("related_docs")
  projectId     String           @map("project_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("decisions")
}

model ExplorationPath {
  id        String              @id @default(cuid())
  category  ExplorationCategory
  projectId String              @map("project_id")
  createdAt DateTime            @default(now()) @map("created_at")

  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions ExplorationQuestion[]

  @@map("exploration_paths")
}

model ExplorationQuestion {
  id            String           @id @default(cuid())
  question      String
  priority      QuestionPriority @default(MEDIUM)
  status        QuestionStatus   @default(OPEN)
  source        String?
  relatedDocs   String[]         @map("related_docs")
  explorationId String           @map("exploration_id")

  exploration ExplorationPath @relation(fields: [explorationId], references: [id], onDelete: Cascade)

  @@map("exploration_questions")
}

model Activity {
  id          String   @id @default(cuid())
  type        String
  description String
  metadata    Json?
  projectId   String   @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Integration {
  id     String            @id @default(cuid())
  name   String
  type   String
  status IntegrationStatus @default(AVAILABLE)
  config Json?

  @@map("integrations")
}
